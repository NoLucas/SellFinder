; package.json's "engines" isn't enforced by default — npm only warns and
; keeps going. Without this, CI's console job would fail deep inside
; `npm test` (node --test crashing on the .ts imports node --test relies
; on native TypeScript stripping for, see tests/*.test.mjs), not at `npm
; ci` where the real cause (wrong Node version) is obvious.
engine-strict=true
