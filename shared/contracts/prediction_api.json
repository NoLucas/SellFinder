{
  "openapi": "3.0.3",
  "info": {
    "title": "SellFinder Prediction API",
    "version": "1.0.0",
    "description": "Contract for the SellFinder prediction service. The backend implements this contract and internally delegates to the /model prediction logic."
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Service health check",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/predictions": {
      "post": {
        "summary": "Predict sell probability, recommended price, and time-to-sell for one or more items",
        "operationId": "createPredictions",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PredictionRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Predictions generated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PredictionResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid request payload",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "422": {
            "description": "Request failed validation",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": {
            "description": "Prediction backend failure",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ItemCondition": {
        "type": "string",
        "enum": ["new", "like_new", "good", "fair", "poor"]
      },
      "PredictionItem": {
        "type": "object",
        "required": ["item_id", "category", "price", "condition"],
        "properties": {
          "item_id": {
            "type": "string",
            "description": "Caller-supplied identifier, echoed back in the response"
          },
          "category": {
            "type": "string",
            "description": "Product category, e.g. 'electronics/laptop'"
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "description": "Asking price of the item"
          },
          "condition": { "$ref": "#/components/schemas/ItemCondition" },
          "brand": {
            "type": "string",
            "nullable": true
          },
          "days_listed": {
            "type": "integer",
            "minimum": 0,
            "nullable": true,
            "description": "Number of days the item has already been listed, if applicable"
          },
          "attributes": {
            "type": "object",
            "additionalProperties": true,
            "nullable": true,
            "description": "Free-form extra features passed through to the model"
          }
        }
      },
      "PredictionRequest": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "$ref": "#/components/schemas/PredictionItem" }
          }
        }
      },
      "ItemPrediction": {
        "type": "object",
        "required": [
          "item_id",
          "sell_probability",
          "estimated_days_to_sell",
          "recommended_price",
          "confidence"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "description": "Matches the item_id from the request"
          },
          "sell_probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Probability the item sells within the model's target window"
          },
          "estimated_days_to_sell": {
            "type": "number",
            "minimum": 0,
            "description": "Expected number of days until sale"
          },
          "recommended_price": {
            "type": "number",
            "minimum": 0,
            "description": "Model-recommended asking price"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Model confidence in this prediction"
          }
        }
      },
      "PredictionResponse": {
        "type": "object",
        "required": ["predictions", "model_version", "generated_at", "is_mock"],
        "properties": {
          "predictions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ItemPrediction" }
          },
          "model_version": {
            "type": "string",
            "description": "Version identifier of the model that produced these predictions"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "is_mock": {
            "type": "boolean",
            "description": "True when the response was produced by the mock predictor instead of the real /model integration"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": ["status", "model_backend"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          },
          "model_backend": {
            "type": "string",
            "enum": ["mock", "live"]
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
